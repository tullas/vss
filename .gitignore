# Environment configuration may contain deployment-specific values or secrets.
config/local.env
config/environments/*.env
!config/environments/*.env.example
.venv/
__pycache__/
*.pyc

# Ansible inventories and vaults are environment-specific and may contain secrets.
ansible/inventories/*/hosts.yml
!ansible/inventories/*/hosts.yml.example
!ansible/inventories/development/hosts.yml
ansible/group_vars/**/vault.yml

# Never commit populated environment files, private keys, or certificates.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# OpenTofu state, plans, and backend configuration are environment-sensitive.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infrastructure/backend.tf
