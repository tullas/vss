{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.option_set/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["option_set_id", "objective_summary", "options", "common_sections"],
  "properties": {
    "option_set_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "objective_summary": {"type": "string", "minLength": 1, "maxLength": 2048},
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/option"}
    },
    "common_sections": {"$ref": "#/$defs/commonSections"}
  },
  "$defs": {
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "statement": {"type": "string", "minLength": 1, "maxLength": 1024},
    "evidenceReference": {"type": "string", "pattern": "^evidence:[a-zA-Z0-9][a-zA-Z0-9._:-]{0,119}$"},
    "identifiedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "statement": {"$ref": "#/$defs/statement"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence_references"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "statement": {"$ref": "#/$defs/statement"},
        "qualification": {"type": "string", "minLength": 1, "maxLength": 512},
        "evidence_references": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceReference"}}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "statement": {"$ref": "#/$defs/statement"},
        "kind": {"enum": ["required", "preferred"]}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis", "qualifications"],
      "properties": {
        "level": {"enum": ["unknown", "low", "medium", "high"]},
        "basis": {"type": "string", "minLength": 1, "maxLength": 512},
        "qualifications": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
      }
    },
    "commonSections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "assumptions", "unknowns", "constraints", "evidence_references", "confidence", "limitations"],
      "properties": {
        "facts": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/fact"}},
        "assumptions": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/identifiedStatement"}},
        "unknowns": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/identifiedStatement"}},
        "constraints": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/constraint"}},
        "evidence_references": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceReference"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "limitations": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/identifiedStatement"}}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "benefits", "drawbacks", "risks", "constraints_satisfied", "constraints_not_satisfied", "evidence_references"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "description": {"type": "string", "minLength": 1, "maxLength": 2048},
        "benefits": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "drawbacks": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "risks": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "constraints_satisfied": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/localId"}},
        "constraints_not_satisfied": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/localId"}},
        "evidence_references": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceReference"}}
      }
    }
  }
}
