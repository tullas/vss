{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.movie.scene_option_review_decision/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_family", "result_version", "request_id", "correlation_id", "project_id", "scene_id", "review_packet_digest", "review_packet_complete_digest", "option_set_digest", "option_set_complete_digest", "payload", "integrity"],
  "properties": {
    "schema_version": {"const": "1"},
    "result_family": {"const": "scene_option_review_decision"},
    "result_version": {"const": "1"},
    "request_id": {"$ref": "#/$defs/id"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "scene_id": {"$ref": "#/$defs/id"},
    "review_packet_digest": {"$ref": "#/$defs/digest"},
    "review_packet_complete_digest": {"$ref": "#/$defs/digest"},
    "option_set_digest": {"$ref": "#/$defs/digest"},
    "option_set_complete_digest": {"$ref": "#/$defs/digest"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["decisions", "source_knowledge_bindings", "knowledge_influence", "authority_boundary", "decision_record_digest"],
      "properties": {
        "decisions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/decision"}},
        "source_knowledge_bindings": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/knowledge_binding"}},
        "knowledge_influence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/knowledge_influence"}]},
        "authority_boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["scope", "production_approval", "production_plan", "scheduling", "workflow_activation", "capability_grant", "runtime_execution"],
          "properties": {
            "scope": {"const": "review_stage_assessment_only"},
            "production_approval": {"const": false}, "production_plan": {"const": false},
            "scheduling": {"const": false}, "workflow_activation": {"const": false},
            "capability_grant": {"const": false}, "runtime_execution": {"const": false}
          }
        },
        "decision_record_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "integrity": {"type": "object", "additionalProperties": false, "required": ["payload_sha256", "complete_result_sha256"], "properties": {"payload_sha256": {"$ref": "#/$defs/digest"}, "complete_result_sha256": {"$ref": "#/$defs/digest"}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conditions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": ".*\\S.*"}},
    "knowledge_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["knowledge_id", "knowledge_content_digest", "admission_decision_id", "admission_decision_digest", "source_candidate", "use"],
      "properties": {
        "knowledge_id": {"$ref": "#/$defs/id"}, "knowledge_content_digest": {"$ref": "#/$defs/digest"},
        "admission_decision_id": {"$ref": "#/$defs/id"}, "admission_decision_digest": {"$ref": "#/$defs/digest"},
        "source_candidate": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_id", "candidate_digest", "candidate_type", "source_pattern_id", "source_pattern_digest", "supporting_evidence_digest", "pattern_set_digest", "pattern_set_complete_digest", "context_id", "context_content_digest", "complete_context_digest"],
          "properties": {
            "candidate_id": {"$ref": "#/$defs/id"}, "candidate_digest": {"$ref": "#/$defs/digest"},
            "candidate_type": {"enum": ["recurrence_lesson_candidate", "variation_lesson_candidate"]},
            "source_pattern_id": {"$ref": "#/$defs/id"}, "source_pattern_digest": {"$ref": "#/$defs/digest"},
            "supporting_evidence_digest": {"$ref": "#/$defs/digest"}, "pattern_set_digest": {"$ref": "#/$defs/digest"},
            "pattern_set_complete_digest": {"$ref": "#/$defs/digest"}, "context_id": {"$ref": "#/$defs/id"},
            "context_content_digest": {"$ref": "#/$defs/digest"}, "complete_context_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "use": {"const": "informational_context_only"}
      }
    },
    "knowledge_influence": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "knowledge_ids", "knowledge_attributes", "knowledge_values"],
      "properties": {
        "mode": {"const": "informational_context_only"},
        "knowledge_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/id"}},
        "knowledge_attributes": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"enum": ["shot_scale", "camera_angle", "camera_elevation", "camera_movement", "composition", "screen_direction", "subject_count", "focal_length_mm"]}},
        "knowledge_values": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "integer", "minimum": 0, "maximum": 128}, {"type": "number", "minimum": 1, "maximum": 2000}]}}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "option_content_digest", "reviewer_id", "outcome", "rationale", "deferred_review_conditions", "decision_digest"],
      "properties": {
        "option_id": {"$ref": "#/$defs/id"}, "option_content_digest": {"$ref": "#/$defs/digest"},
        "reviewer_id": {"$ref": "#/$defs/id"}, "outcome": {"enum": ["accept", "reject", "defer"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": ".*\\S.*"},
        "deferred_review_conditions": {"$ref": "#/$defs/conditions"}, "decision_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
