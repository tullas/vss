{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.resource.media_provenance_view/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_identity", "contract_version", "provenance_id", "request_sha256", "scope", "output", "production_input", "lineage", "rights", "preservation", "reproducibility", "unavailable_evidence", "limitations", "result_sha256"],
  "properties": {
    "schema_version": {"const": "1"}, "contract_identity": {"const": "media_provenance_view"}, "contract_version": {"const": "1"},
    "provenance_id": {"type": "string", "pattern": "^media-provenance-[0-9a-f]{32}$"}, "request_sha256": {"$ref": "#/$defs/digest"},
    "scope": {"$ref": "#/$defs/scope"}, "output": {"$ref": "#/$defs/output"}, "production_input": {"$ref": "#/$defs/productionInput"},
    "lineage": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/lineage"}},
    "rights": {"$ref": "#/$defs/rights"},
    "preservation": {"type": "object", "additionalProperties": false, "required": ["class", "payload_availability"], "properties": {"class": {"const": "disposable_intermediate_review_material"}, "payload_availability": {"const": "caller_supplied_not_persisted"}}},
    "reproducibility": {"type": "object", "additionalProperties": false, "required": ["level", "content_identity_verified", "semantic_replay_claimed", "operational_replay_claimed", "exact_byte_replay_claimed"], "properties": {"level": {"const": "identity_and_provenance"}, "content_identity_verified": {"const": true}, "semantic_replay_claimed": {"const": false}, "operational_replay_claimed": {"const": false}, "exact_byte_replay_claimed": {"const": false}}},
    "unavailable_evidence": {"type": "array", "const": ["model_identity", "model_version", "provider_identity", "provider_version", "runtime_environment_identity"]},
    "limitations": {"type": "array", "const": ["inert_provenance_view", "not_production_approval", "not_runtime_authority", "not_provider_authority", "not_workflow_authority", "not_scheduling_authority", "not_regeneration_authority", "not_export_or_publication_authority", "not_storage_or_deletion_authority", "not_rights_authority", "not_reproducibility_guarantee", "exact_artifact_revision_only"]},
    "result_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "universe_id", "production_id", "scene_id", "scope_kind"], "properties": {"tenant_id": {"$ref": "#/$defs/id"}, "universe_id": {"$ref": "#/$defs/id"}, "production_id": {"$ref": "#/$defs/id"}, "scene_id": {"$ref": "#/$defs/id"}, "scope_kind": {"const": "production_scene"}}},
    "output": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_sha256", "resource_id", "resource_revision", "resource_kind", "content_sha256", "media_type"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[0-9a-f]{32}$"}, "artifact_sha256": {"$ref": "#/$defs/digest"}, "resource_id": {"type": "string", "pattern": "^resource-[0-9a-f]{32}$"}, "resource_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "resource_kind": {"const": "storyboard_review_frame"}, "content_sha256": {"$ref": "#/$defs/digest"}, "media_type": {"const": "image/png"}}},
    "productionInput": {"type": "object", "additionalProperties": false, "required": ["decision_id", "decision_revision", "decision_sha256", "canon_snapshot_id", "canon_snapshot_version", "canon_sha256", "binding_id", "binding_sha256"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[0-9a-f]{32}$"}, "decision_revision": {"type": "integer", "minimum": 1}, "decision_sha256": {"$ref": "#/$defs/digest"}, "canon_snapshot_id": {"type": "string", "pattern": "^canon-[0-9a-f]{32}$"}, "canon_snapshot_version": {"type": "integer", "minimum": 1}, "canon_sha256": {"$ref": "#/$defs/digest"}, "binding_id": {"type": "string", "pattern": "^production-canon-binding-[0-9a-f]{32}$"}, "binding_sha256": {"$ref": "#/$defs/digest"}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["kind", "identity", "version", "sha256"], "properties": {"kind": {"enum": ["canon_snapshot", "creative_decision_revision", "pictorial_admission", "production_canon_binding", "review_decision", "scene_breakdown", "shot_plan_draft", "storyboard_frame", "storyboard_specification"]}, "identity": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 32}, "sha256": {"$ref": "#/$defs/digest"}}},
    "rights": {"type": "object", "additionalProperties": false, "required": ["ownership_class", "status", "permissions", "restrictions", "rights_reference", "rights_policy_identity", "rights_policy_version"], "properties": {"ownership_class": {"enum": ["customer_owned", "vss_owned", "third_party", "public_domain", "open_licensed", "joint"]}, "status": {"enum": ["confirmed", "unknown", "conflicting"]}, "permissions": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["use_in_source_production", "reuse_as_universe_visual_reference"]}}, "restrictions": {"type": "array", "minItems": 0, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["no_reuse", "no_training", "no_redistribution", "no_publication"]}}, "rights_reference": {"$ref": "#/$defs/id"}, "rights_policy_identity": {"const": "vss.resource-rights"}, "rights_policy_version": {"const": "1.0.0"}}}
  }
}
