{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"vss.resource.production_resource_artifact/1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","contract_identity","contract_version","artifact_id","resource_id","resource_revision","resource_kind","scope","activity","content_sha256","media_type","rights","lineage","artifact_sha256"],
  "properties":{
    "schema_version":{"const":"1"},"contract_identity":{"const":"production_resource_artifact"},"contract_version":{"const":"1"},
    "artifact_id":{"$ref":"#/$defs/artifactId"},"resource_id":{"$ref":"#/$defs/resourceId"},"resource_revision":{"type":"integer","minimum":1,"maximum":2147483647},
    "resource_kind":{"const":"storyboard_review_frame"},"scope":{"$ref":"#/$defs/productionScope"},"activity":{"$ref":"#/$defs/activity"},
    "content_sha256":{"$ref":"#/$defs/digest"},"media_type":{"const":"image/png"},"rights":{"$ref":"#/$defs/rights"},
    "lineage":{"$ref":"#/$defs/lineage"},"artifact_sha256":{"$ref":"#/$defs/digest"}
  },
  "$defs":{
    "id":{"type":"string","minLength":3,"maxLength":128,"pattern":"^[a-z][a-z0-9._:-]*$"},
    "artifactId":{"type":"string","pattern":"^artifact-[0-9a-f]{32}$"},"resourceId":{"type":"string","pattern":"^resource-[0-9a-f]{32}$"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "productionScope":{"type":"object","additionalProperties":false,"required":["tenant_id","universe_id","production_id"],"properties":{"tenant_id":{"$ref":"#/$defs/id"},"universe_id":{"oneOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"production_id":{"$ref":"#/$defs/id"}}},
    "activity":{"type":"object","additionalProperties":false,"required":["activity_id","operation_identity","operation_version","output_name","pictorial_admission_id","storyboard_specification_digest","frame_id","frame_specification_digest","semantic_request_digest"],"properties":{"activity_id":{"type":"string","pattern":"^pictorial-activity-[0-9a-f]{32}$"},"operation_identity":{"const":"generate_one_pictorial_storyboard_frame"},"operation_version":{"const":"1"},"output_name":{"const":"review_frame"},"pictorial_admission_id":{"$ref":"#/$defs/digest"},"storyboard_specification_digest":{"$ref":"#/$defs/digest"},"frame_id":{"type":"string","pattern":"^frame-[0-9a-f]{24}$"},"frame_specification_digest":{"$ref":"#/$defs/digest"},"semantic_request_digest":{"$ref":"#/$defs/digest"}}},
    "rights":{"type":"object","additionalProperties":false,"required":["ownership_class","status","permissions","restrictions","rights_reference","rights_policy_identity","rights_policy_version"],"properties":{"ownership_class":{"enum":["customer_owned","vss_owned","third_party","public_domain","open_licensed","joint"]},"status":{"enum":["confirmed","unknown","conflicting"]},"permissions":{"type":"array","minItems":0,"maxItems":3,"uniqueItems":true,"items":{"enum":["use_in_source_production","reuse_as_universe_visual_reference","modify"]}},"restrictions":{"type":"array","minItems":0,"maxItems":4,"uniqueItems":true,"items":{"enum":["no_reuse","no_training","no_redistribution","no_publication"]}},"rights_reference":{"$ref":"#/$defs/id"},"rights_policy_identity":{"const":"vss.resource-rights"},"rights_policy_version":{"const":"1.0.0"}}},
    "lineage":{"type":"object","additionalProperties":false,"required":["kind","ancestors"],"properties":{"kind":{"const":"exact_production_output"},"ancestors":{"type":"array","minItems":0,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["resource_id","resource_revision","content_sha256"],"properties":{"resource_id":{"$ref":"#/$defs/resourceId"},"resource_revision":{"type":"integer","minimum":1,"maximum":2147483647},"content_sha256":{"$ref":"#/$defs/digest"}}}}}}
  }
}
