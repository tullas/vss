{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/provider-certification-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_identity", "contract_version", "provider", "product_service", "model_version", "supported_regions", "generation_modes", "request_schema_mapping", "authentication", "submission_semantics", "async_operation_semantics", "polling_fetch_semantics", "terminal_response_forms", "artifact_delivery_forms", "recovery_semantics", "media_contract", "quota_evidence", "pricing_evidence", "unsupported_probes", "deprecations", "authoritative_sources", "conformance", "live_certification", "production_eligibility", "authority"],
  "properties": {
    "schema_version": {"const": "1"}, "contract_identity": {"const": "vss.provider-certification"}, "contract_version": {"const": "1"},
    "provider": {"type": "string", "minLength": 1}, "product_service": {"type": "string", "minLength": 1}, "model_version": {"type": "string", "minLength": 1},
    "supported_regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "generation_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "request_schema_mapping": {"type": "object", "additionalProperties": false, "required": ["transport", "mapping", "unknowns"], "properties": {"transport": {"type": "string", "minLength": 1}, "mapping": {"type": "object", "additionalProperties": false, "required": ["prompt", "image", "duration_seconds", "resolution", "sample_count"], "properties": {"prompt": {"type": "string"}, "image": {"type": "string"}, "duration_seconds": {"type": "string"}, "resolution": {"type": "string"}, "sample_count": {"type": "string"}}}, "unknowns": {"type": "array", "items": {"type": "string"}}}},
    "authentication": {"type": "object", "additionalProperties": false, "required": ["requirements", "unknowns"], "properties": {"requirements": {"type": "array", "items": {"type": "string"}}, "unknowns": {"type": "array", "items": {"type": "string"}}}},
    "submission_semantics": {"type": "object", "additionalProperties": false, "required": ["method", "accepted_response", "provider_calls"], "properties": {"method": {"type": "string"}, "accepted_response": {"type": "string"}, "provider_calls": {"type": "integer"}}}, "async_operation_semantics": {"type": "object", "additionalProperties": false, "required": ["fetch_method", "operation_name_required", "polling"], "properties": {"fetch_method": {"type": "string"}, "operation_name_required": {"type": "boolean"}, "polling": {"type": "string"}}}, "polling_fetch_semantics": {"type": "object", "additionalProperties": false, "required": ["method", "same_operation_recovery", "unknowns"], "properties": {"method": {"type": "string"}, "same_operation_recovery": {"type": "boolean"}, "unknowns": {"type": "array", "items": {"type": "string"}}}}, "terminal_response_forms": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "field", "mime"], "properties": {"kind": {"type": "string"}, "field": {"type": "string"}, "mime": {"type": "string"}}}}, "artifact_delivery_forms": {"type": "array", "items": {"type": "string"}}, "recovery_semantics": {"type": "object", "additionalProperties": false, "required": ["rule", "duplicate_submission"], "properties": {"rule": {"type": "string"}, "duplicate_submission": {"type": "boolean"}}}, "media_contract": {"type": "object", "additionalProperties": false, "required": ["duration_seconds", "image_to_video_duration_seconds", "resolution", "fps", "audio", "maximum_outputs", "image_max_bytes"], "properties": {"duration_seconds": {"type": "array", "items": {"type": "integer"}}, "image_to_video_duration_seconds": {"type": "array", "items": {"type": "integer"}}, "resolution": {"type": "array", "items": {"type": "string"}}, "fps": {"type": "array", "items": {"type": "integer"}}, "audio": {"type": "string"}, "maximum_outputs": {"type": "integer"}, "image_max_bytes": {"type": "integer"}}}, "quota_evidence": {"type": "object", "additionalProperties": false, "required": ["mode", "recorded_local_evidence", "metric", "project", "effective_limit", "freshness"], "properties": {"mode": {"type": "string"}, "recorded_local_evidence": {"type": "string"}, "metric": {"type": "string"}, "project": {"type": "string"}, "effective_limit": {"type": "integer"}, "freshness": {"type": "string"}}}, "pricing_evidence": {"type": "object", "additionalProperties": false, "required": ["expected_shot_cost_usd", "hard_ceiling_usd", "rate_basis", "authoritative_quote"], "properties": {"expected_shot_cost_usd": {"type": "string"}, "hard_ceiling_usd": {"type": "string"}, "rate_basis": {"type": "string"}, "authoritative_quote": {"type": "string"}}},
    "unsupported_probes": {"type": "array", "items": {"type": "string"}}, "deprecations": {"type": "array", "items": {"type": "string"}}, "authoritative_sources": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["title", "url", "claims"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "claims": {"type": "array", "items": {"type": "string"}}}}},
    "conformance": {"type": "object", "additionalProperties": false, "required": ["status", "fixtures", "provider_calls"], "properties": {"status": {"const": "passed"}, "fixtures": {"type": "array", "items": {"type": "string"}}, "provider_calls": {"const": 0}}},
    "live_certification": {"type": "object", "additionalProperties": false, "required": ["status", "certified_at", "evidence"], "properties": {"status": {"enum": ["UNKNOWN", "CERTIFIED", "STALE"]}, "certified_at": {"type": ["string", "null"]}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "production_eligibility": {"type": "object", "additionalProperties": false, "required": ["eligible", "reason"], "properties": {"eligible": {"type": "boolean"}, "reason": {"type": "string"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["provider_execution", "production", "publication", "workflow_activation", "retry", "fallback"], "properties": {"provider_execution": {"const": false}, "production": {"const": false}, "publication": {"const": false}, "workflow_activation": {"const": false}, "retry": {"const": false}, "fallback": {"const": false}}}
  }
}
