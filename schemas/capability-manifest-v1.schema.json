{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/capability-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "namespace", "name", "version", "description",
    "runtime_api_version", "entry_point", "commands", "permissions",
    "compatibility", "lifecycle_status"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "namespace": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "runtime_api_version": {"type": "string"},
    "entry_point": {"type": "string", "minLength": 1},
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input_schema", "output_schema", "supports_dry_run"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
          "input_schema": {"type": "object"},
          "output_schema": {"type": "object"},
          "supports_dry_run": {"type": "boolean"}
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "filesystem_read", "filesystem_write", "network", "subprocess",
          "secrets", "docker_socket", "privileged_host", "repository_write",
          "provider_access"
        ]
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python"],
      "properties": {"python": {"type": "string", "minLength": 1}}
    },
    "lifecycle_status": {"enum": ["experimental", "active", "deprecated", "retired"]}
  }
}
