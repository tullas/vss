    "source":{"type":"object","additionalProperties":false,"required":["artifact_id","artifact_sha256","resource_id","resource_revision","content_sha256","tenant_id","universe_id","production_id"],"properties":{"artifact_id":{"type":"string","pattern":"^artifact-[0-9a-f]{32}$"},"artifact_sha256":{"$ref":"#/$defs/digest"},"resource_id":{"type":"string","pattern":"^resource-[0-9a-f]{32}$"},"resource_revision":{"type":"integer","minimum":1,"maximum":2147483647},"content_sha256":{"$ref":"#/$defs/digest"},"tenant_id":{"$ref":"#/$defs/id"},"universe_id":{"$ref":"#/$defs/id"},"production_id":{"$ref":"#/$defs/id"}}},
