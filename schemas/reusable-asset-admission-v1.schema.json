    "admission_id":{"type":"string","pattern":"^asset-admission-[0-9a-f]{32}$"},"operation_identity":{"const":"admit_storyboard_review_frame_as_universe_visual_reference"},"operation_version":{"const":"1"},"decision":{"const":"admit"},
    "source":{"$ref":"#/$defs/source"},"destination":{"$ref":"#/$defs/destination"},"purpose":{"const":"storyboard_visual_reference"},
