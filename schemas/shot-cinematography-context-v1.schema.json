{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.shot_cinematography_context/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "context_id", "context_family", "context_family_version", "purpose", "project_id", "scene_id", "classification", "policy_identity", "policy_version", "construction_basis", "lifecycle", "observation_set_id", "observation_set_digest", "selection_digest", "context_content_digest", "integrity", "payload"],
  "properties": {
    "schema_version": {"const": "1"},
    "context_id": {"type": "string", "pattern": "^shot-context-[0-9a-f]{32}$"},
    "context_family": {"const": "shot_cinematography_context"},
    "context_family_version": {"const": "1"},
    "purpose": {"const": "shot_cinematography_local_analysis"},
    "project_id": {"$ref": "#/$defs/id"},
    "scene_id": {"type": "string", "pattern": "^scene-[a-z0-9][a-z0-9._-]{0,47}$"},
    "classification": {"enum": ["public", "internal"]},
    "policy_identity": {"const": "shot_cinematography_context_local"},
    "policy_version": {"const": "1"},
    "construction_basis": {"const": "deterministic_validated_inputs"},
    "lifecycle": {"const": "validated"},
    "observation_set_id": {"type": "string", "pattern": "^shot-observation-set-[a-z0-9][a-z0-9._-]{0,43}$"},
    "observation_set_digest": {"$ref": "#/$defs/digest"},
    "selection_digest": {"$ref": "#/$defs/digest"},
    "context_content_digest": {"$ref": "#/$defs/digest"},
    "integrity": {"type": "object", "additionalProperties": false, "required": ["complete_context_sha256"], "properties": {"complete_context_sha256": {"$ref": "#/$defs/digest"}}},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["set_semantics", "observations", "unknowns", "limitations", "budget_summary"],
      "properties": {
        "set_semantics": {"const": "unordered_exact"},
        "observations": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/observation"}},
        "unknowns": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "limitations": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "budget_summary": {"type": "object", "additionalProperties": false, "required": ["minimum_observations", "maximum_observations", "maximum_future_pairwise_comparisons", "maximum_context_bytes"], "properties": {"minimum_observations": {"const": 2}, "maximum_observations": {"const": 8}, "maximum_future_pairwise_comparisons": {"const": 28}, "maximum_context_bytes": {"const": 65536}}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["observed", "uncertain"]},
    "unavailable": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["unknown", "not_observed", "not_applicable"]}}},
    "qualifiedString": {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"$ref": "#/$defs/status"}, "value": {"type": "string"}}},
    "shotScale": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"allOf": [{"$ref": "#/$defs/qualifiedString"}, {"properties": {"value": {"enum": ["extreme_close_up", "close_up", "medium_close_up", "medium", "medium_wide", "wide", "extreme_wide"]}}}]}]},
    "cameraAngle": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"allOf": [{"$ref": "#/$defs/qualifiedString"}, {"properties": {"value": {"enum": ["level", "high_angle", "low_angle", "dutch_angle"]}}}]}]},
    "elevation": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"allOf": [{"$ref": "#/$defs/qualifiedString"}, {"properties": {"value": {"enum": ["ground", "low", "eye_level", "elevated", "overhead"]}}}]}]},
    "movement": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"allOf": [{"$ref": "#/$defs/qualifiedString"}, {"properties": {"value": {"enum": ["static", "pan", "tilt", "dolly", "truck", "pedestal", "zoom", "crane", "orbit"]}}}]}]},
    "composition": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"allOf": [{"$ref": "#/$defs/qualifiedString"}, {"properties": {"value": {"enum": ["centered", "rule_of_thirds", "symmetrical", "frame_within_frame"]}}}]}]},
    "direction": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"allOf": [{"$ref": "#/$defs/qualifiedString"}, {"properties": {"value": {"enum": ["left_facing", "right_facing", "toward_camera", "away_from_camera"]}}}]}]},
    "subjectCount": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"$ref": "#/$defs/status"}, "value": {"type": "integer", "minimum": 0, "maximum": 128}}}]},
    "focalLength": {"oneOf": [{"$ref": "#/$defs/unavailable"}, {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"$ref": "#/$defs/status"}, "value": {"type": "number", "minimum": 1, "maximum": 2000}}}]},
    "attributes": {"type": "object", "additionalProperties": false, "required": ["shot_scale", "camera_angle", "camera_elevation", "camera_movement", "composition", "subject_count", "screen_direction", "focal_length_mm"], "properties": {"shot_scale": {"$ref": "#/$defs/shotScale"}, "camera_angle": {"$ref": "#/$defs/cameraAngle"}, "camera_elevation": {"$ref": "#/$defs/elevation"}, "camera_movement": {"$ref": "#/$defs/movement"}, "composition": {"$ref": "#/$defs/composition"}, "subject_count": {"$ref": "#/$defs/subjectCount"}, "screen_direction": {"$ref": "#/$defs/direction"}, "focal_length_mm": {"$ref": "#/$defs/focalLength"}}, "allOf": [{"if": {"properties": {"screen_direction": {"properties": {"status": {"enum": ["observed", "uncertain"]}}, "required": ["status"]}}}, "then": {"properties": {"subject_count": {"type": "object", "required": ["status", "value"], "properties": {"status": {"const": "observed"}, "value": {"const": 1}}}}}}]},
    "provenance": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "observer_id", "method_identity"], "properties": {"kind": {"const": "manual_observation"}, "observer_id": {"$ref": "#/$defs/id"}, "method_identity": {"const": "manual_declaration"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "observer_id", "method_identity"], "properties": {"kind": {"const": "synthetic_test_observation"}, "observer_id": {"$ref": "#/$defs/id"}, "method_identity": {"const": "synthetic_fixture"}}}]},
    "observation": {"type": "object", "additionalProperties": false, "required": ["observation_identity", "observation_version", "observation_id", "observation_content_digest", "shot_id", "evidence_reference", "attributes", "provenance", "limitations"], "properties": {"observation_identity": {"const": "shot_cinematography_observation"}, "observation_version": {"const": "1"}, "observation_id": {"type": "string", "pattern": "^shot-observation-[a-z0-9][a-z0-9._-]{0,47}$"}, "observation_content_digest": {"$ref": "#/$defs/digest"}, "shot_id": {"type": "string", "pattern": "^shot-[a-z0-9][a-z0-9._-]{0,47}$"}, "evidence_reference": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9._-]{0,47}$"}, "attributes": {"$ref": "#/$defs/attributes"}, "provenance": {"$ref": "#/$defs/provenance"}, "limitations": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}}
  }
}
