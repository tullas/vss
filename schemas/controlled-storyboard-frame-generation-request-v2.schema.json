{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.resource.controlled_storyboard_frame_generation_request/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_identity", "contract_version", "operation_identity", "operation_version", "environment", "purpose", "scope", "lineage", "eligibility", "capability", "provider", "projection", "bounds", "request_sha256"],
  "properties": {
    "schema_version": {"const": "1"},
    "contract_identity": {"const": "controlled_storyboard_frame_generation_request"},
    "contract_version": {"const": "2"},
    "operation_identity": {"const": "generate_one_controlled_storyboard_review_frame"},
    "operation_version": {"const": "1"},
    "environment": {"const": "development"},
    "purpose": {"const": "development_storyboard_review_candidate"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_id", "universe_id", "production_id", "project_id", "scene_id", "frame_id"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/id"}, "universe_id": {"$ref": "#/$defs/id"},
        "production_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"},
        "scene_id": {"$ref": "#/$defs/id"}, "frame_id": {"type": "string", "pattern": "^frame-[0-9a-f]{24}$"}
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["story_fragment", "scene_breakdown", "production_option_set", "review_packet", "review_decision", "creative_decision_revision", "canon_snapshot", "production_canon_binding", "shot_plan_draft", "storyboard_specification", "storyboard_frame"],
      "properties": {
        "story_fragment": {"$ref": "#/$defs/digest"}, "scene_breakdown": {"$ref": "#/$defs/digest"},
        "production_option_set": {"$ref": "#/$defs/digest"}, "review_packet": {"$ref": "#/$defs/digest"},
        "review_decision": {"$ref": "#/$defs/digest"}, "creative_decision_revision": {"$ref": "#/$defs/digest"},
        "canon_snapshot": {"$ref": "#/$defs/digest"}, "production_canon_binding": {"$ref": "#/$defs/digest"},
        "shot_plan_draft": {"$ref": "#/$defs/digest"}, "storyboard_specification": {"$ref": "#/$defs/digest"},
        "storyboard_frame": {"$ref": "#/$defs/digest"}
      }
    },
    "eligibility": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "trust", "rights_qualification", "permissions", "restrictions", "policy_identity", "policy_version"],
      "properties": {
        "classification": {"const": "public"}, "trust": {"const": "approved_fixture"},
        "rights_qualification": {"enum": ["original", "explicitly_authorized"]},
        "permissions": {"type": "array", "const": ["external_provider_processing", "generate_development_review_media"]},
        "restrictions": {"type": "array", "const": []},
        "policy_identity": {"const": "vss.controlled-media-input-eligibility"}, "policy_version": {"const": "1.0.0"}
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "version", "manifest_sha256", "handler_sha256"],
      "properties": {
        "identity": {"const": "movie.controlled-review-frame"}, "version": {"const": "1.1.0"},
        "manifest_sha256": {"$ref": "#/$defs/digest"}, "handler_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "provider": {"$ref": "#/$defs/provider"},
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "projection_sha256"],
      "properties": {"prompt": {"type": "string", "minLength": 1, "maxLength": 4096}, "projection_sha256": {"$ref": "#/$defs/digest"}}
    },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_provider_attempts", "maximum_images", "maximum_output_bytes", "maximum_content_credentials_bytes", "maximum_cost_usd"],
      "properties": {
        "maximum_provider_attempts": {"const": 1}, "maximum_images": {"const": 1},
        "maximum_output_bytes": {"const": 10485760}, "maximum_content_credentials_bytes": {"const": 4194304},
        "maximum_cost_usd": {"const": "0.100000"}
      }
    },
    "request_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "version", "implementation_identity", "model_snapshot", "endpoint", "method", "settings", "price_policy_identity", "data_policy_identity", "output_policy_identity", "manifest_sha256", "implementation_sha256", "provider_request_sha256"],
      "properties": {
        "identity": {"const": "movie.storyboard-image.openai"}, "version": {"const": "1.1.0"},
        "implementation_identity": {"const": "vss.openai-gpt-image-2-opaque-cabx"},
        "model_snapshot": {"const": "gpt-image-2-2026-04-21"},
        "endpoint": {"const": "https://api.openai.com/v1/images/generations"}, "method": {"const": "POST"},
        "settings": {
          "type": "object", "additionalProperties": false,
          "required": ["n", "size", "quality", "output_format", "background", "moderation", "stream"],
          "properties": {"n": {"const": 1}, "size": {"const": "1280x720"}, "quality": {"const": "medium"}, "output_format": {"const": "png"}, "background": {"const": "opaque"}, "moderation": {"const": "auto"}, "stream": {"const": false}}
        },
        "price_policy_identity": {"const": "openai-gpt-image-2-standard-2026-08-24/1"},
        "data_policy_identity": {"const": "openai-images-generations-data-2026-08-24/1"},
        "output_policy_identity": {"const": "vss.opaque-provider-content-credentials.png/1"},
        "manifest_sha256": {"$ref": "#/$defs/digest"}, "implementation_sha256": {"$ref": "#/$defs/digest"},
        "provider_request_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
