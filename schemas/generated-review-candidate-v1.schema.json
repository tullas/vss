{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "vss.resource.generated_review_candidate/1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_identity", "contract_version", "candidate_id", "status", "request_sha256", "approval_sha256", "attempt_sha256", "lineage", "scope", "provider", "response", "media", "eligibility", "preservation", "authority", "limitations", "candidate_sha256"],
  "properties": {
    "schema_version": {"const": "1"}, "contract_identity": {"const": "generated_review_candidate"}, "contract_version": {"const": "1"},
    "candidate_id": {"type": "string", "pattern": "^generated-review-[0-9a-f]{32}$"}, "status": {"const": "development_review_quarantined"},
    "request_sha256": {"$ref": "#/$defs/digest"}, "approval_sha256": {"$ref": "#/$defs/digest"}, "attempt_sha256": {"$ref": "#/$defs/digest"},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["story_fragment", "scene_breakdown", "production_option_set", "review_packet", "review_decision", "creative_decision_revision", "canon_snapshot", "production_canon_binding", "shot_plan_draft", "storyboard_specification", "storyboard_frame"], "properties": {"story_fragment": {"$ref": "#/$defs/digest"}, "scene_breakdown": {"$ref": "#/$defs/digest"}, "production_option_set": {"$ref": "#/$defs/digest"}, "review_packet": {"$ref": "#/$defs/digest"}, "review_decision": {"$ref": "#/$defs/digest"}, "creative_decision_revision": {"$ref": "#/$defs/digest"}, "canon_snapshot": {"$ref": "#/$defs/digest"}, "production_canon_binding": {"$ref": "#/$defs/digest"}, "shot_plan_draft": {"$ref": "#/$defs/digest"}, "storyboard_specification": {"$ref": "#/$defs/digest"}, "storyboard_frame": {"$ref": "#/$defs/digest"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "universe_id", "production_id", "project_id", "scene_id", "frame_id"], "properties": {"tenant_id": {"$ref": "#/$defs/id"}, "universe_id": {"$ref": "#/$defs/id"}, "production_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "scene_id": {"$ref": "#/$defs/id"}, "frame_id": {"$ref": "#/$defs/id"}}},
    "provider": {"type": "object", "additionalProperties": false, "required": ["identity", "version", "model_snapshot", "endpoint", "settings", "provider_request_sha256", "projection_sha256", "price_policy_identity", "data_policy_identity"], "properties": {"identity": {"const": "movie.storyboard-image.openai"}, "version": {"const": "1.0.0"}, "model_snapshot": {"const": "gpt-image-2-2026-04-21"}, "endpoint": {"const": "https://api.openai.com/v1/images/generations"}, "settings": {"type": "object", "additionalProperties": false, "required": ["n", "size", "quality", "output_format", "background", "moderation", "stream"], "properties": {"n": {"const": 1}, "size": {"const": "1280x720"}, "quality": {"const": "medium"}, "output_format": {"const": "png"}, "background": {"const": "opaque"}, "moderation": {"const": "auto"}, "stream": {"const": false}}}, "provider_request_sha256": {"$ref": "#/$defs/digest"}, "projection_sha256": {"$ref": "#/$defs/digest"}, "price_policy_identity": {"const": "openai-gpt-image-2-standard-2026-08-24/1"}, "data_policy_identity": {"const": "openai-images-generations-data-2026-08-24/1"}}},
    "response": {"type": "object", "additionalProperties": false, "required": ["response_sha256", "provider_created", "request_id", "latency_ms", "usage", "estimated_cost_usd"], "properties": {"response_sha256": {"$ref": "#/$defs/digest"}, "provider_created": {"type": ["integer", "null"], "minimum": 0}, "request_id": {"type": ["string", "null"], "maxLength": 128}, "latency_ms": {"type": "integer", "minimum": 0, "maximum": 600000}, "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000}, "output_tokens": {"type": "integer", "minimum": 0, "maximum": 10000000}, "total_tokens": {"type": "integer", "minimum": 0, "maximum": 20000000}}}, "estimated_cost_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"}}},
    "media": {"type": "object", "additionalProperties": false, "required": ["content_sha256", "media_type", "width", "height", "byte_count", "content_credentials_present"], "properties": {"content_sha256": {"$ref": "#/$defs/digest"}, "media_type": {"const": "image/png"}, "width": {"const": 1280}, "height": {"const": 720}, "byte_count": {"type": "integer", "minimum": 1, "maximum": 10485760}, "content_credentials_present": {"const": false}}},
    "eligibility": {"type": "object", "additionalProperties": false, "required": ["input", "output"], "properties": {"input": {"const": "eligible_public_external_processing"}, "output": {"const": "quarantined_development_review_only"}}},
    "preservation": {"type": "object", "additionalProperties": false, "required": ["policy", "durable", "reproducibility"], "properties": {"policy": {"const": "disposable_local"}, "durable": {"const": false}, "reproducibility": {"const": "identity_and_provenance_only"}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["production", "asset", "publication", "export", "workflow", "scheduling", "provider_execution", "runtime_execution"], "properties": {"production": {"const": false}, "asset": {"const": false}, "publication": {"const": false}, "export": {"const": false}, "workflow": {"const": false}, "scheduling": {"const": false}, "provider_execution": {"const": false}, "runtime_execution": {"const": false}}},
    "limitations": {"type": "array", "const": ["development_review_media_only", "not_a_final_selection", "not_a_production_asset", "not_reproducible_pixels", "no_retention_guarantee"]},
    "candidate_sha256": {"$ref": "#/$defs/digest"}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9._:-]*$"}}
}
