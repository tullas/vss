{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.context_object/1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "context_id", "context_contract_identity", "context_contract_version", "context_family", "context_family_version", "request_id", "correlation_id", "semantic_task", "semantic_task_version", "purpose", "environment", "project_id", "classification", "policy_identity", "policy_version", "package_set_digest", "selection_digest", "context_content_digest", "governance_report_digest", "constructed_at", "expires_at", "lifecycle", "integrity", "payload"],
  "properties": {
    "schema_version": {"const": "1"}, "context_id": {"type": "string", "maxLength": 128}, "context_contract_identity": {"const": "context_object"}, "context_contract_version": {"const": "1"}, "context_family": {"const": "generate_options_context"}, "context_family_version": {"const": "1"}, "request_id": {"type": "string", "maxLength": 128}, "correlation_id": {"type": "string", "maxLength": 128}, "semantic_task": {"const": "generate_options"}, "semantic_task_version": {"const": "1"}, "purpose": {"const": "generate_options_local_validation"}, "environment": {"const": "development"}, "project_id": {"type": "string", "maxLength": 64}, "classification": {"enum": ["public", "internal"]}, "policy_identity": {"const": "generate_options_context_local"}, "policy_version": {"const": "1"}, "package_set_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "selection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "context_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "governance_report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "constructed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "lifecycle": {"const": "validated"}, "integrity": {"type": "object", "additionalProperties": false, "required": ["complete_context_sha256"], "properties": {"complete_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "payload": {"$ref": "#/$defs/payload"}
  },
  "$defs": {"payload": {"type": "object", "additionalProperties": false, "required": ["selected_notes", "evidence_references", "conflicts", "uncertainty", "limitations", "source_qualifications", "budget_summary"], "properties": {"selected_notes": {"type": "array", "maxItems": 8}, "evidence_references": {"type": "array", "maxItems": 32}, "conflicts": {"type": "array", "maxItems": 16}, "uncertainty": {"type": "array", "minItems": 1, "maxItems": 16}, "limitations": {"type": "array", "minItems": 1, "maxItems": 16}, "source_qualifications": {"type": "array", "maxItems": 8}, "budget_summary": {"type": "object"}}}}
}
