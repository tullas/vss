{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/performance-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "report_sha256", "profile", "workload", "commit", "environment", "configuration", "counters", "latency", "throughput_requests_per_second", "resources", "semantic_validation", "audit_validation", "phases", "failures", "warnings", "status", "started_at", "completed_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "report_id": {"type": "string", "pattern": "^perf-[0-9a-f]{32}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"$ref": "#/$defs/identity"},
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "fixture_identity", "fixture_sha256"],
      "properties": {
        "identity": {"const": "reasoning.generate-options/1"},
        "fixture_identity": {"const": "generate-options-runtime-valid/1"},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_system", "platform_release", "architecture", "python_version", "logical_cpu_count", "available_memory_bytes", "wsl", "ci"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1, "maxLength": 128},
        "platform_release": {"type": "string", "minLength": 1, "maxLength": 256},
        "architecture": {"type": "string", "minLength": 1, "maxLength": 128},
        "python_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 4096},
        "available_memory_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 1152921504606846976},
        "wsl": {"type": "boolean"}, "ci": {"type": "boolean"}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "dry_run", "warmup_requests", "measured_requests", "concurrency", "maximum_outstanding", "request_timeout_seconds", "total_timeout_seconds", "endurance_enabled"],
      "properties": {
        "environment": {"const": "development"}, "dry_run": {"type": "boolean"},
        "warmup_requests": {"type": "integer", "minimum": 0, "maximum": 32},
        "measured_requests": {"type": "integer", "minimum": 1, "maximum": 500},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "maximum_outstanding": {"type": "integer", "minimum": 1, "maximum": 16},
        "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "total_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "endurance_enabled": {"type": "boolean"}
      }
    },
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["admitted", "completed", "successes", "failures", "timeouts", "cancellations", "audit_failures", "semantic_mismatches"],
      "properties": {
        "admitted": {"$ref": "#/$defs/count"}, "completed": {"$ref": "#/$defs/count"},
        "successes": {"$ref": "#/$defs/count"}, "failures": {"$ref": "#/$defs/count"},
        "timeouts": {"$ref": "#/$defs/count"}, "cancellations": {"$ref": "#/$defs/count"},
        "audit_failures": {"$ref": "#/$defs/count"}, "semantic_mismatches": {"$ref": "#/$defs/count"}
      }
    },
    "latency": {"$ref": "#/$defs/latency"},
    "throughput_requests_per_second": {"type": "number", "minimum": 0, "maximum": 1000000000},
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "after", "thread_delta", "audit_bytes_appended"],
      "properties": {
        "before": {"$ref": "#/$defs/resources"}, "after": {"$ref": "#/$defs/resources"},
        "thread_delta": {"type": "integer", "minimum": -1024, "maximum": 1024},
        "audit_bytes_appended": {"type": ["integer", "null"], "minimum": 0, "maximum": 8388608}
      }
    },
    "semantic_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_content_digest", "observed_content_digests", "digest_match", "expected_option_count"],
      "properties": {
        "expected_content_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "observed_content_digests": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "digest_match": {"type": "boolean"},
        "expected_option_count": {"type": ["integer", "null"], "minimum": 1, "maximum": 8}
      }
    },
    "audit_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "records", "missing_terminal_records", "duplicate_terminal_records", "invalid_associations", "malformed_records"],
      "properties": {
        "enabled": {"type": "boolean"}, "records": {"$ref": "#/$defs/count"},
        "missing_terminal_records": {"$ref": "#/$defs/count"}, "duplicate_terminal_records": {"$ref": "#/$defs/count"},
        "invalid_associations": {"$ref": "#/$defs/count"}, "malformed_records": {"$ref": "#/$defs/count"}
      }
    },
    "phases": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/phase"}},
    "failures": {"type": "object", "maxProperties": 32, "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"}, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 500}},
    "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "status": {"enum": ["success", "failed"]},
    "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"configuration": {"properties": {"dry_run": {"const": true}}}}},
      "then": {"properties": {"semantic_validation": {"properties": {
        "expected_content_digest": {"type": "null"},
        "observed_content_digests": {"maxItems": 0},
        "expected_option_count": {"type": "null"}
      }}}}
    },
    {
      "if": {"properties": {"configuration": {"properties": {"dry_run": {"const": false}}}, "status": {"const": "success"}}},
      "then": {"properties": {"semantic_validation": {"properties": {
        "expected_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_content_digests": {"minItems": 1, "maxItems": 1},
        "digest_match": {"const": true},
        "expected_option_count": {"type": "integer"}
      }}}}
    },
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {"properties": {
        "counters": {"properties": {
          "failures": {"const": 0}, "timeouts": {"const": 0},
          "cancellations": {"const": 0}, "audit_failures": {"const": 0},
          "semantic_mismatches": {"const": 0}
        }},
        "audit_validation": {"properties": {
          "enabled": {"const": true},
          "missing_terminal_records": {"const": 0},
          "duplicate_terminal_records": {"const": 0},
          "invalid_associations": {"const": 0}, "malformed_records": {"const": 0}
        }},
        "failures": {"maxProperties": 0},
        "phases": {"items": {"properties": {
          "cancellations": {"const": 0}, "timed_out": {"const": false}, "failures": {"const": 0}
        }}}
      }}
    }
  ],
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["identity", "version", "sha256"],
      "properties": {"identity": {"enum": ["ci_safe", "laptop_small", "laptop_standard"]}, "version": {"const": "1"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 1000},
    "finiteMetric": {"type": "number", "minimum": 0, "maximum": 1000000000},
    "latency": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_count", "min_ms", "mean_ms", "p50_ms", "p90_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "sample_count": {"$ref": "#/$defs/count"}, "min_ms": {"$ref": "#/$defs/finiteMetric"},
        "mean_ms": {"$ref": "#/$defs/finiteMetric"}, "p50_ms": {"$ref": "#/$defs/finiteMetric"},
        "p90_ms": {"$ref": "#/$defs/finiteMetric"}, "p95_ms": {"$ref": "#/$defs/finiteMetric"},
        "p99_ms": {"$ref": "#/$defs/finiteMetric"}, "max_ms": {"$ref": "#/$defs/finiteMetric"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["process_cpu_seconds", "maximum_resident_set_kib", "active_thread_count", "open_file_descriptor_count"],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0, "maximum": 1000000000},
        "maximum_resident_set_kib": {"type": ["integer", "null"], "minimum": 0, "maximum": 1152921504606846976},
        "active_thread_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "open_file_descriptor_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "requests", "submitted", "completed", "cancellations", "timed_out", "concurrency", "maximum_outstanding", "successes", "failures", "duration_seconds"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "requests": {"$ref": "#/$defs/count"}, "submitted": {"$ref": "#/$defs/count"},
        "completed": {"$ref": "#/$defs/count"}, "cancellations": {"$ref": "#/$defs/count"},
        "timed_out": {"type": "boolean"}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "maximum_outstanding": {"type": "integer", "minimum": 1, "maximum": 16},
        "successes": {"$ref": "#/$defs/count"}, "failures": {"$ref": "#/$defs/count"},
        "duration_seconds": {"type": "number", "minimum": 0, "maximum": 300}
      }
    },
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$", "maxLength": 32}
  }
}
