{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.movie.record_scene_option_review_decision/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_identity", "task_version", "request_id", "correlation_id", "project_id", "scene_id", "environment", "purpose", "expected_input_family", "expected_input_version", "expected_result_family", "expected_result_version", "review_packet_digest", "review_packet_complete_digest", "option_set_digest", "option_set_complete_digest", "option_id", "option_content_digest", "reviewer_id", "outcome", "rationale", "deferred_review_conditions", "lifecycle", "task_content_digest"],
  "properties": {
    "schema_version": {"const": "1"},
    "task_identity": {"const": "record_scene_option_review_decision"},
    "task_version": {"const": "1"},
    "request_id": {"$ref": "#/$defs/id"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "scene_id": {"$ref": "#/$defs/id"},
    "environment": {"const": "development"},
    "purpose": {"const": "accountable_human_scene_option_review_assessment"},
    "expected_input_family": {"const": "scene_option_review_packet"},
    "expected_input_version": {"const": "1"},
    "expected_result_family": {"const": "scene_option_review_decision"},
    "expected_result_version": {"const": "1"},
    "review_packet_digest": {"$ref": "#/$defs/digest"},
    "review_packet_complete_digest": {"$ref": "#/$defs/digest"},
    "option_set_digest": {"$ref": "#/$defs/digest"},
    "option_set_complete_digest": {"$ref": "#/$defs/digest"},
    "option_id": {"$ref": "#/$defs/id"},
    "option_content_digest": {"$ref": "#/$defs/digest"},
    "reviewer_id": {"$ref": "#/$defs/id"},
    "outcome": {"enum": ["accept", "reject", "defer"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": ".*\\S.*"},
    "deferred_review_conditions": {"$ref": "#/$defs/conditions"},
    "lifecycle": {"const": "active"},
    "task_content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conditions": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": ".*\\S.*"}}
  }
}
