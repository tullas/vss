    "evidence_references": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 256}}, "conflicts": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "item_ids", "status", "qualification"], "properties": {"conflict_id": {"type": "string", "maxLength": 128}, "item_ids": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "maxLength": 128}}, "status": {"const": "unresolved"}, "qualification": {"type": "string", "maxLength": 512}}}},
    "uncertainty": {"type": "array", "maxItems": 16, "minItems": 1, "items": {"type": "string", "maxLength": 512}}, "limitations": {"type": "array", "maxItems": 16, "minItems": 1, "items": {"type": "string", "maxLength": 512}}, "source_qualifications": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 256}}, "budget_summary": {"type": "object", "additionalProperties": false, "required": ["maximum_context_bytes", "context_bytes", "selected_items", "evidence_references"], "properties": {"maximum_context_bytes": {"type": "integer", "minimum": 1}, "context_bytes": {"type": "integer", "minimum": 1}, "selected_items": {"type": "integer", "minimum": 1, "maximum": 8}, "evidence_references": {"type": "integer", "minimum": 0, "maximum": 32}}}
