{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.context_assembly_request/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "correlation_id", "semantic_task", "semantic_task_version", "context_family", "context_family_version", "policy_identity", "policy_version", "purpose", "environment", "project_id", "validation_time", "classification_ceiling", "minimum_trust", "package_requirements", "item_requirements", "budgets", "deadline_seconds", "lifecycle"],
  "properties": {
    "schema_version": {"const": "1"}, "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "correlation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "semantic_task": {"const": "generate_options"}, "semantic_task_version": {"const": "1"}, "context_family": {"const": "generate_options_context"}, "context_family_version": {"const": "1"},
    "policy_identity": {"const": "generate_options_context_local"}, "policy_version": {"const": "1"}, "purpose": {"const": "generate_options_local_validation"}, "environment": {"const": "development"}, "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}, "validation_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "classification_ceiling": {"enum": ["public", "internal"]}, "minimum_trust": {"const": "approved_fixture"},
    "package_requirements": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["package_id", "package_contract_identity", "package_contract_version", "package_content_sha256", "requirement"], "properties": {"package_id": {"type": "string", "maxLength": 128}, "package_contract_identity": {"const": "knowledge_package"}, "package_contract_version": {"const": "1"}, "package_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "requirement": {"enum": ["required", "optional"]}}}},
    "item_requirements": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "item_family", "item_family_version", "item_content_sha256", "requirement"], "properties": {"item_id": {"type": "string", "maxLength": 128}, "item_family": {"const": "reference_note"}, "item_family_version": {"const": "1"}, "item_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "requirement": {"enum": ["required", "optional"]}}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["maximum_context_bytes", "maximum_items", "maximum_evidence_references"], "properties": {"maximum_context_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}, "maximum_items": {"type": "integer", "minimum": 1, "maximum": 8}, "maximum_evidence_references": {"type": "integer", "minimum": 0, "maximum": 32}}},
    "deadline_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 30}, "lifecycle": {"const": "requested"}
  }
}
