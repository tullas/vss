{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/provider-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "provider_api_version", "provider_type", "name",
    "version", "identity", "implementation", "implementation_identity",
    "lifecycle_status", "source"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "provider_api_version": {"type": "string"},
    "provider_type": {"enum": ["clock", "storyboard_render", "storyboard_image_generation", "controlled_storyboard_image_generation"]},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "identity": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$"},
    "implementation": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*\\.py:[A-Za-z][A-Za-z0-9_]*$"},
    "implementation_identity": {"type": "string", "minLength": 1, "maxLength": 100},
    "lifecycle_status": {"enum": ["experimental", "active", "deprecated", "retired"]},
    "source": {"enum": ["trusted_builtin"]}
  }
}
