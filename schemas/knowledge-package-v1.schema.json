{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"vss.knowledge_package/1",
  "$defs":{"id":{"type":"string","pattern":"^[a-z][a-z0-9._:-]{0,127}$"},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}},
  "type":"object","additionalProperties":false,
  "required":["schema_version","package_id","package_contract_identity","package_contract_version","correlation_id","permitted_purpose","task_family","classification","lifecycle_status","constructed_at","expires_at","retention_until","source_references","item_references","items","provenance_summary","freshness_summary","classification_summary","redaction_summary","conflict_summary","uncertainty_summary","revocation_summary","lineage","integrity"],
  "properties":{
    "schema_version":{"const":"1"},"package_id":{"$ref":"#/$defs/id"},"package_contract_identity":{"const":"knowledge_package"},"package_contract_version":{"const":"1"},"correlation_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},"permitted_purpose":{"const":"local_validation_context"},"task_family":{"const":"local_validation"},"classification":{"enum":["public","internal"]},"lifecycle_status":{"enum":["constructed","validated","expired","revoked"]},
    "constructed_at":{"$ref":"#/$defs/time"},"expires_at":{"$ref":"#/$defs/time"},"retention_until":{"$ref":"#/$defs/time"},
    "source_references":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"const":"vss.local.reference-fixtures"}},
    "item_references":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "items":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object"}},
    "provenance_summary":{"type":"object","additionalProperties":false,"required":["source_count","transformation_count"],"properties":{"source_count":{"type":"integer","minimum":1,"maximum":8},"transformation_count":{"type":"integer","minimum":1,"maximum":64}}},
    "freshness_summary":{"enum":["all_current","contains_stale","contains_expired","unknown"]},
    "classification_summary":{"type":"object","additionalProperties":false,"required":["maximum","item_count"],"properties":{"maximum":{"enum":["public","internal"]},"item_count":{"type":"integer","minimum":1,"maximum":8}}},
    "redaction_summary":{"type":"object","additionalProperties":false,"required":["policy_identity","policy_version","status","removed_field_count"],"properties":{"policy_identity":{"const":"vss.no-redaction-required"},"policy_version":{"const":"1"},"status":{"const":"not_required"},"removed_field_count":{"const":0}}},
    "conflict_summary":{"type":"object","additionalProperties":false,"required":["status","conflicts"],"properties":{"status":{"enum":["none_detected","conflicts_present"]},"conflicts":{"type":"array","maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["conflict_id","item_ids","statement"],"properties":{"conflict_id":{"$ref":"#/$defs/id"},"item_ids":{"type":"array","minItems":2,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"statement":{"type":"string","minLength":1,"maxLength":256}}}}}},
    "uncertainty_summary":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","minLength":1,"maxLength":256}},
    "revocation_summary":{"type":"object","additionalProperties":false,"required":["status","revoked_item_ids"],"properties":{"status":{"enum":["none","revoked"]},"revoked_item_ids":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "lineage":{"type":"array","minItems":5,"maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["step_id","kind","input_sha256","output_sha256","item_id"],"properties":{"step_id":{"$ref":"#/$defs/id"},"kind":{"enum":["source","normalized_payload","validated_item","package_content","complete_package"]},"input_sha256":{"$ref":"#/$defs/digest"},"output_sha256":{"$ref":"#/$defs/digest"},"item_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}}}},
    "integrity":{"type":"object","additionalProperties":false,"required":["package_content_sha256","complete_package_sha256","registry_sha256"],"properties":{"package_content_sha256":{"$ref":"#/$defs/digest"},"complete_package_sha256":{"$ref":"#/$defs/digest"},"registry_sha256":{"$ref":"#/$defs/digest"}}}
  }
}
