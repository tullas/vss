{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.movie.shot_cinematography_observation_set/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_identity", "contract_version", "observation_set_id", "project_id", "scene_id", "purpose", "classification", "set_semantics", "bounds", "observations", "limitations", "content_digest"],
  "properties": {
    "schema_version": {"const": "1"},
    "contract_identity": {"const": "shot_cinematography_observation_set"},
    "contract_version": {"const": "1"},
    "observation_set_id": {"type": "string", "pattern": "^shot-observation-set-[a-z0-9][a-z0-9._-]{0,43}$"},
    "project_id": {"$ref": "#/$defs/id"},
    "scene_id": {"type": "string", "pattern": "^scene-[a-z0-9][a-z0-9._-]{0,47}$"},
    "purpose": {"const": "shot_cinematography_local_analysis"},
    "classification": {"enum": ["public", "internal"]},
    "set_semantics": {"const": "unordered_exact"},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["minimum_observations", "maximum_observations"], "properties": {"minimum_observations": {"const": 2}, "maximum_observations": {"const": 8}}},
    "observations": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["observation_identity", "observation_version", "observation_id", "observation_content_digest", "shot_id"], "properties": {"observation_identity": {"const": "shot_cinematography_observation"}, "observation_version": {"const": "1"}, "observation_id": {"type": "string", "pattern": "^shot-observation-[a-z0-9][a-z0-9._-]{0,47}$"}, "observation_content_digest": {"$ref": "#/$defs/digest"}, "shot_id": {"type": "string", "pattern": "^shot-[a-z0-9][a-z0-9._-]{0,47}$"}}}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
