{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"vss.resource.creative_decision_revision/1","type":"object","additionalProperties":false,
  "required":["schema_version","contract_identity","contract_version","decision_id","revision","decision_kind","scope","status","semantic_payload","previous_revision","dependencies","evidence_references","limitations","decision_sha256"],
  "properties":{
    "schema_version":{"const":"1"},"contract_identity":{"const":"creative_decision_revision"},"contract_version":{"const":"1"},
    "decision_id":{"type":"string","pattern":"^decision-[0-9a-f]{32}$"},"revision":{"type":"integer","minimum":1,"maximum":2147483647},"decision_kind":{"const":"scene_production_option_selection"},
    "scope":{"$ref":"#/$defs/scope"},"status":{"enum":["accepted","rejected","deprecated","superseded"]},"semantic_payload":{"$ref":"#/$defs/payload"},
    "previous_revision":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/prior"}]},
    "dependencies":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/dependency"}},
    "evidence_references":{"type":"array","minItems":0,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "limitations":{"type":"array","const":["inert_creative_decision","not_production_approval","not_runtime_authority","not_provider_authority","not_workflow_authority","not_rights_authority","exact_revision_only"]},
    "decision_sha256":{"$ref":"#/$defs/digest"}
  },
  "$defs":{
    "id":{"type":"string","minLength":3,"maxLength":128,"pattern":"^[a-z][a-z0-9._:-]*$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "scope":{"type":"object","additionalProperties":false,"required":["tenant_id","universe_id","production_id","scene_id","scope_kind"],"properties":{"tenant_id":{"$ref":"#/$defs/id"},"universe_id":{"$ref":"#/$defs/id"},"production_id":{"$ref":"#/$defs/id"},"scene_id":{"$ref":"#/$defs/id"},"scope_kind":{"const":"production_scene"}}},
    "payload":{"type":"object","additionalProperties":false,"required":["option_id","option_content_digest","review_outcome","reviewer_accountability_id","decision_record_digest","decision_complete_digest","review_packet_digest","review_packet_complete_digest","option_set_digest","option_set_complete_digest","scene_breakdown_digest","scene_breakdown_payload_digest","scene_content_digest"],"properties":{"option_id":{"type":"string","pattern":"^option-[0-9a-f]{24}$"},"option_content_digest":{"$ref":"#/$defs/digest"},"review_outcome":{"enum":["accept","reject","defer"]},"reviewer_accountability_id":{"$ref":"#/$defs/id"},"decision_record_digest":{"$ref":"#/$defs/digest"},"decision_complete_digest":{"$ref":"#/$defs/digest"},"review_packet_digest":{"$ref":"#/$defs/digest"},"review_packet_complete_digest":{"$ref":"#/$defs/digest"},"option_set_digest":{"$ref":"#/$defs/digest"},"option_set_complete_digest":{"$ref":"#/$defs/digest"},"scene_breakdown_digest":{"$ref":"#/$defs/digest"},"scene_breakdown_payload_digest":{"$ref":"#/$defs/digest"},"scene_content_digest":{"$ref":"#/$defs/digest"}}},
    "prior":{"type":"object","additionalProperties":false,"required":["decision_id","revision","decision_sha256"],"properties":{"decision_id":{"type":"string","pattern":"^decision-[0-9a-f]{32}$"},"revision":{"type":"integer","minimum":1,"maximum":2147483647},"decision_sha256":{"$ref":"#/$defs/digest"}}},
    "dependency":{"type":"object","additionalProperties":false,"required":["kind","identity","digest"],"properties":{"kind":{"enum":["scene_breakdown","production_option_set","review_packet","review_decision"]},"identity":{"$ref":"#/$defs/id"},"digest":{"$ref":"#/$defs/digest"}}}
  }
}
