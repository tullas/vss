    "rights":{"type":"object","additionalProperties":false,"required":["ownership_class","status","permission","restrictions","rights_reference","rights_policy_identity","rights_policy_version"],"properties":{"ownership_class":{"enum":["customer_owned","vss_owned","third_party","public_domain","open_licensed","joint"]},"status":{"const":"confirmed"},"permission":{"const":"reuse_as_universe_visual_reference"},"restrictions":{"type":"array","minItems":0,"maxItems":3,"uniqueItems":true,"items":{"enum":["no_training","no_redistribution","no_publication"]}},"rights_reference":{"$ref":"#/$defs/id"},"rights_policy_identity":{"const":"vss.resource-rights"},"rights_policy_version":{"const":"1.0.0"}}}
