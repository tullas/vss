{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/dev-improvement-candidate-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "candidates", "authority"],
  "properties": {
    "schema_version": {"const": "1"},
    "protocol": {"const": "vss.dev-improvement-backlog"},
    "candidates": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "protocol", "candidate_id", "source", "category", "problem_statement", "evidence", "expected_benefit_dimensions", "risk", "architectural_fit", "disposition", "trigger", "priority", "authority_required", "status", "advisory", "implementation_authorized"],
      "properties": {
        "schema_version": {"const": "1"},
        "protocol": {"const": "vss.dev-improvement-candidate"},
        "candidate_id": {"type": "string", "pattern": "^improvement-[0-9a-f]{24}$"},
        "source": {"type": "object", "additionalProperties": false, "required": ["milestone_id", "observation_id", "finding"], "properties": {
          "milestone_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "observation_id": {"type": "string", "pattern": "^obs-[a-z0-9-]{1,48}$"},
          "finding": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S"}
        }},
        "category": {"enum": ["telemetry", "context", "session-policy", "handoff", "human-friction", "validation", "capacity", "cache", "host", "analysis", "measurement", "milestone-semantics"]},
        "problem_statement": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["reference", "digest"], "properties": {"reference": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"}, "digest": {"$ref": "#/$defs/digest"}}}},
        "expected_benefit_dimensions": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["continuity", "context-efficiency", "validation-speed", "validation-scope", "human-friction", "resource-efficiency", "decision-quality", "observability"]}},
        "risk": {"enum": ["low", "medium", "high", "unknown"]},
        "architectural_fit": {"enum": ["extend-existing", "requires-boundary-review", "requires-new-authority", "unknown", "not-fit"]},
        "disposition": {"enum": ["implement-now", "prerequisite", "deferred", "rejected"]},
        "trigger": {"type": "object", "additionalProperties": false, "required": ["kind", "condition"], "properties": {"kind": {"enum": ["milestone-boundary", "evidence", "human-review", "prerequisite"]}, "condition": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"}}},
        "priority": {"type": "integer", "minimum": 1, "maximum": 5},
        "authority_required": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["human-review", "architecture-review", "strategic-review", "none"]}},
        "status": {"enum": ["queued", "closed"]},
        "advisory": {"const": true},
        "implementation_authorized": {"const": false}
      }
    },
    "authority": {"type": "object", "additionalProperties": false, "required": ["runtime_execution", "provider_execution", "production", "publication", "workflow_activation", "security_exception", "product_authority", "merge", "push"], "properties": {"runtime_execution": {"const": false}, "provider_execution": {"const": false}, "production": {"const": false}, "publication": {"const": false}, "workflow_activation": {"const": false}, "security_exception": {"const": false}, "product_authority": {"const": false}, "merge": {"const": false}, "push": {"const": false}}}
  }
}
