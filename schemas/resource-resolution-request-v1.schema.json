{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"vss.resource.resource_resolution_request/1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","contract_identity","contract_version","request_id","operation_identity","operation_version","consumer","purpose","asset","source","admission","permission","restrictions","rights_reference","request_sha256"],
  "properties":{
    "schema_version":{"const":"1"},"contract_identity":{"const":"resource_resolution_request"},"contract_version":{"const":"1"},
    "request_id":{"type":"string","pattern":"^resource-resolution-[0-9a-f]{32}$"},"operation_identity":{"const":"resolve_universe_visual_reference_for_production"},"operation_version":{"const":"1"},
    "consumer":{"$ref":"#/$defs/consumer"},"purpose":{"const":"storyboard_visual_reference"},"asset":{"$ref":"#/$defs/asset"},"source":{"$ref":"#/$defs/source"},"admission":{"$ref":"#/$defs/admission"},
    "permission":{"const":"reuse_as_universe_visual_reference"},"restrictions":{"type":"array","minItems":0,"maxItems":3,"uniqueItems":true,"items":{"enum":["no_training","no_redistribution","no_publication"]}},
    "rights_reference":{"$ref":"#/$defs/id"},"request_sha256":{"$ref":"#/$defs/digest"}
  },
  "$defs":{
    "id":{"type":"string","minLength":3,"maxLength":128,"pattern":"^[a-z][a-z0-9._:-]*$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "consumer":{"type":"object","additionalProperties":false,"required":["tenant_id","universe_id","production_id","scope_kind"],"properties":{"tenant_id":{"$ref":"#/$defs/id"},"universe_id":{"$ref":"#/$defs/id"},"production_id":{"$ref":"#/$defs/id"},"scope_kind":{"const":"production"}}},
    "asset":{"type":"object","additionalProperties":false,"required":["asset_id","asset_revision","asset_sha256","content_sha256"],"properties":{"asset_id":{"type":"string","pattern":"^asset-[0-9a-f]{32}$"},"asset_revision":{"type":"integer","minimum":1,"maximum":2147483647},"asset_sha256":{"$ref":"#/$defs/digest"},"content_sha256":{"$ref":"#/$defs/digest"}}},
    "source":{"type":"object","additionalProperties":false,"required":["artifact_id","artifact_sha256","resource_id","resource_revision"],"properties":{"artifact_id":{"type":"string","pattern":"^artifact-[0-9a-f]{32}$"},"artifact_sha256":{"$ref":"#/$defs/digest"},"resource_id":{"type":"string","pattern":"^resource-[0-9a-f]{32}$"},"resource_revision":{"type":"integer","minimum":1,"maximum":2147483647}}},
    "admission":{"type":"object","additionalProperties":false,"required":["admission_id","admission_sha256"],"properties":{"admission_id":{"type":"string","pattern":"^asset-admission-[0-9a-f]{32}$"},"admission_sha256":{"$ref":"#/$defs/digest"}}}
  }
}
