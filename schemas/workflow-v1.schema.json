{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/workflow-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "name", "version", "description",
    "runtime_api_version", "execution_policy", "steps"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "runtime_api_version": {"type": "string"},
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "stop_on_failure"],
      "properties": {
        "mode": {"const": "sequential"},
        "stop_on_failure": {"const": true}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation", "input", "timeout_seconds", "continue_on_error"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
          "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
          "input": {"type": "object"},
          "timeout_seconds": {"type": "number", "minimum": 0.001, "maximum": 300},
          "continue_on_error": {"const": false}
        }
      }
    }
  }
}
