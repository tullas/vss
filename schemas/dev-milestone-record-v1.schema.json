{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vss.local/schemas/dev-milestone-record-v1.schema.json",
  "oneOf": [{"$ref": "#/$defs/state"}, {"$ref": "#/$defs/event"}],
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "authority": {"type": "object", "additionalProperties": false, "required": ["runtime_execution", "provider_execution", "production", "publication", "workflow_activation", "security_exception", "product_authority", "merge", "push"], "properties": {"runtime_execution": {"const": false}, "provider_execution": {"const": false}, "production": {"const": false}, "publication": {"const": false}, "workflow_activation": {"const": false}, "security_exception": {"const": false}, "product_authority": {"const": false}, "merge": {"const": false}, "push": {"const": false}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["schema_version", "protocol", "record_kind", "milestone_id", "generation", "status", "repository", "scope", "validation", "ci", "repair", "routing", "next", "history_tail", "policy_sha256", "authority"], "properties": {"schema_version": {"const": "1"}, "protocol": {"const": "vss.dev-milestone"}, "record_kind": {"const": "state"}, "milestone_id": {"$ref": "#/$defs/id"}, "generation": {"type": "integer", "minimum": 0, "maximum": 256}, "status": {"enum": ["DESIGN_REVIEW_REQUIRED", "READY_FOR_IMPLEMENTATION", "WORKING", "LOCAL_VALIDATION_REQUIRED", "CI_PENDING", "REPAIRING", "CANONICAL_VALIDATION_REQUIRED", "REVIEW_READY", "BLOCKED", "CONFLICT", "COMPLETE"]}, "repository": {"type": "object", "additionalProperties": false, "required": ["name_with_owner", "branch", "base_sha", "head_sha", "change_identity"], "properties": {"name_with_owner": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "branch": {"type": "string", "minLength": 1, "maxLength": 200}, "base_sha": {"$ref": "#/$defs/sha1"}, "head_sha": {"$ref": "#/$defs/sha1"}, "change_identity": {"$ref": "#/$defs/sha256"}}}, "scope": {"type": "object", "additionalProperties": false, "required": ["issue", "domains", "paths"], "properties": {"issue": {"type": "integer", "minimum": 1}, "domains": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "paths": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}}}, "validation": {"type": "object", "additionalProperties": false, "required": ["evidence_sha256", "level"], "properties": {"evidence_sha256": {"type": ["null", "string"], "pattern": "^[0-9a-f]{64}$"}, "level": {"enum": ["none", "L0", "L1", "L2", "L3"]}}}, "ci": {"type": "object", "additionalProperties": false, "required": ["head_sha", "status", "classification"], "properties": {"head_sha": {"type": ["null", "string"], "pattern": "^[0-9a-f]{40}$"}, "status": {"enum": ["not_observed", "pending", "passed", "failed", "stale"]}, "classification": {"enum": ["none", "code", "fixture", "security", "infrastructure", "flaky/unknown"]}}}, "repair": {"type": "object", "additionalProperties": false, "required": ["attempts", "stop_reason"], "properties": {"attempts": {"type": "integer", "minimum": 0, "maximum": 3}, "stop_reason": {"type": ["null", "string"], "maxLength": 128}}}, "routing": {"type": "object", "additionalProperties": false, "required": ["model", "advisory"], "properties": {"model": {"enum": ["gpt-5.6-sol-high", "gpt-5.6-terra-medium", "gpt-5.6-terra-low"]}, "advisory": {"const": true}}}, "next": {"type": "object", "additionalProperties": false, "required": ["action", "human_boundary"], "properties": {"action": {"enum": ["request_design_review", "start_bounded_work", "run_affected_validation", "run_subsystem_validation", "ingest_ci", "repair_code", "repair_fixture", "reproduce_flaky", "run_canonical_validation", "request_architecture_review", "request_security_review", "request_merge", "recover_state", "resolve_conflict", "none"]}, "human_boundary": {"type": "boolean"}}}, "history_tail": {"type": "object", "additionalProperties": false, "required": ["sequence", "sha256"], "properties": {"sequence": {"type": "integer", "minimum": 0, "maximum": 256}, "sha256": {"$ref": "#/$defs/sha256"}}}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "authority": {"$ref": "#/$defs/authority"}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["schema_version", "protocol", "record_kind", "milestone_id", "sequence", "event_type", "prior_event_sha256", "subject_head_sha", "summary", "data", "event_sha256", "authority"], "properties": {"schema_version": {"const": "1"}, "protocol": {"const": "vss.dev-milestone"}, "record_kind": {"const": "event"}, "milestone_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 256}, "event_type": {"enum": ["initialized", "branch_transitioned", "validation_invalidated", "checkpointed", "validation_completed", "ci_observed", "repair_started", "repair_completed", "blocked", "completed"]}, "prior_event_sha256": {"$ref": "#/$defs/sha256"}, "subject_head_sha": {"$ref": "#/$defs/sha1"}, "summary": {"type": "string", "minLength": 1, "maxLength": 512}, "data": {"type": "object", "additionalProperties": false, "properties": {"issue": {"type": "integer", "minimum": 1}, "domains": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "paths": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}}, "initial_branch": {"$ref": "#/$defs/branch"}, "from_branch": {"$ref": "#/$defs/branch"}, "to_branch": {"$ref": "#/$defs/branch"}, "base_sha": {"$ref": "#/$defs/sha1"}, "change_identity": {"$ref": "#/$defs/sha256"}, "recovered_event_sha256": {"$ref": "#/$defs/sha256"}, "validation_level": {"enum": ["none", "L0", "L1", "L2", "L3"]}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "ci_status": {"enum": ["not_observed", "pending", "passed", "failed", "stale"]}, "ci_classification": {"enum": ["none", "code", "fixture", "security", "infrastructure", "flaky/unknown"]}, "ci_head_sha": {"$ref": "#/$defs/sha1"}, "repair_attempts": {"type": "integer", "minimum": 0, "maximum": 3}, "stop_reason": {"type": "string", "minLength": 1, "maxLength": 128}}}, "event_sha256": {"$ref": "#/$defs/sha256"}, "authority": {"$ref": "#/$defs/authority"}}}
  }
}
