  "$defs": {
    "mission": {"type":"object","additionalProperties":false,"required":["gap","observable_result","authority_alignment","triggers","heartbeat","active_decisions"],"properties":{"gap":{"type":"string","minLength":1,"maxLength":240,"pattern":"\\S"},"observable_result":{"type":"string","minLength":1,"maxLength":240,"pattern":"\\S"},"authority_alignment":{"enum":["aligned","unknown","conflicting"]},"triggers":{"type":"array","maxItems":4,"uniqueItems":true,"items":{"enum":["strategic_concern","creative_production_authority","provider_media_transition","architecture_boundary"]}},"heartbeat":{"type":"array","minItems":1,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["milestone_id","capability","advanced","evidence"],"properties":{"milestone_id":{"$ref":"#/$defs/id"},"capability":{"enum":["story","scene","storyboard","image","moving_shot","multi_shot_scene","dialogue_audio","edited_scene","rough_film","finished_poc"]},"advanced":{"type":"boolean"},"evidence":{"type":"string","minLength":1,"maxLength":160,"pattern":"\\S"}}}},"active_decisions":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","disposition","rationale"],"properties":{"id":{"type":"string","pattern":"^DEC-[0-9]{4}$"},"disposition":{"enum":["COMPLY","CHALLENGE","NOT_APPLICABLE"]},"rationale":{"type":"string","minLength":1,"maxLength":240,"pattern":"\\S"}}}}}},
    "mission_review": {"type":"object","additionalProperties":false,"required":["mechanism","disposition","owner","evidence"],"properties":{"mechanism":{"enum":["strategic","constitutional","unknown_unknown"]},"disposition":{"enum":["CONTINUE","CONTINUE_WITH_GUARDRAIL","REMEDIATE_FIRST","STRATEGIC_REASSESSMENT","ACCEPT","REVISE","REJECT"]},"owner":{"type":"string","minLength":1,"maxLength":80,"pattern":"\\S"},"evidence":{"type":"string","minLength":1,"maxLength":240,"pattern":"\\S"}}},
