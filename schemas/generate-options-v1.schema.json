{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.generate_options/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["objective", "constraints", "desired_option_count"],
  "properties": {
    "objective": {"type": "string", "minLength": 1, "maxLength": 2048},
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "desired_option_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "evaluation_dimensions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    }
  }
}
