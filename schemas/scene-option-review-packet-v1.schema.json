{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vss.movie.scene_option_review_packet/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_family", "result_version", "request_id", "correlation_id", "project_id", "scene_id", "option_set_digest", "option_set_complete_digest", "payload", "integrity"],
  "properties": {
    "schema_version": {"const": "1"},
    "result_family": {"const": "scene_option_review_packet"},
    "result_version": {"const": "1"},
    "request_id": {"$ref": "#/$defs/id"},
    "correlation_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "scene_id": {"$ref": "#/$defs/id"},
    "option_set_digest": {"$ref": "#/$defs/digest"},
    "option_set_complete_digest": {"$ref": "#/$defs/digest"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_knowledge_bindings", "stable_order_is_not_ranking", "review_entries", "shared_review_prompts", "limitations", "review_packet_digest"],
      "properties": {
        "source_knowledge_bindings": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/knowledge_binding"}},
        "stable_order_is_not_ranking": {"const": true},
        "review_entries": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/review_entry"}},
        "shared_review_prompts": {"$ref": "#/$defs/nonempty_strings"},
        "limitations": {"$ref": "#/$defs/nonempty_strings"},
        "review_packet_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_sha256", "complete_result_sha256"],
      "properties": {"payload_sha256": {"$ref": "#/$defs/digest"}, "complete_result_sha256": {"$ref": "#/$defs/digest"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "nonempty_strings": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "knowledge_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["knowledge_id", "knowledge_content_digest", "admission_decision_id", "admission_decision_digest", "source_candidate", "use"],
      "properties": {
        "knowledge_id": {"$ref": "#/$defs/id"}, "knowledge_content_digest": {"$ref": "#/$defs/digest"},
        "admission_decision_id": {"$ref": "#/$defs/id"}, "admission_decision_digest": {"$ref": "#/$defs/digest"},
        "source_candidate": {
          "type": "object", "additionalProperties": false,
          "required": ["candidate_id", "candidate_digest", "candidate_type", "source_pattern_id", "source_pattern_digest", "supporting_evidence_digest", "pattern_set_digest", "pattern_set_complete_digest", "context_id", "context_content_digest", "complete_context_digest"],
          "properties": {
            "candidate_id": {"$ref": "#/$defs/id"}, "candidate_digest": {"$ref": "#/$defs/digest"},
            "candidate_type": {"enum": ["recurrence_lesson_candidate", "variation_lesson_candidate"]},
            "source_pattern_id": {"$ref": "#/$defs/id"}, "source_pattern_digest": {"$ref": "#/$defs/digest"},
            "supporting_evidence_digest": {"$ref": "#/$defs/digest"}, "pattern_set_digest": {"$ref": "#/$defs/digest"},
            "pattern_set_complete_digest": {"$ref": "#/$defs/digest"}, "context_id": {"$ref": "#/$defs/id"},
            "context_content_digest": {"$ref": "#/$defs/digest"}, "complete_context_digest": {"$ref": "#/$defs/digest"}
          }
        },
        "use": {"const": "informational_context_only"}
      }
    },
    "knowledge_influence": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "knowledge_ids", "knowledge_attributes", "knowledge_values"],
      "properties": {
        "mode": {"const": "informational_context_only"},
        "knowledge_ids": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/id"}},
        "knowledge_attributes": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"enum": ["shot_scale", "camera_angle", "camera_elevation", "camera_movement", "composition", "screen_direction", "subject_count", "focal_length_mm"]}},
        "knowledge_values": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "integer", "minimum": 0, "maximum": 128}, {"type": "number", "minimum": 1, "maximum": 2000}]}}
      }
    },
    "considerations": {
      "type": "object", "additionalProperties": false,
      "required": ["approach_category", "complexity_qualification", "qualified_rationale", "source_supported_considerations", "rule_derived_considerations", "performer_requirement_categories", "location_approach_category", "asset_requirement_categories", "effects_intensity_category", "audio_considerations", "prototype_suitability", "evidence_references", "qualified_confidence"],
      "properties": {
        "approach_category": {"type": "string", "minLength": 1, "maxLength": 128},
        "complexity_qualification": {"type": "string", "minLength": 1, "maxLength": 256},
        "qualified_rationale": {"type": "string", "minLength": 1, "maxLength": 1024},
        "source_supported_considerations": {"$ref": "#/$defs/strings"},
        "rule_derived_considerations": {"$ref": "#/$defs/strings"},
        "performer_requirement_categories": {"$ref": "#/$defs/strings"},
        "location_approach_category": {"type": "string", "minLength": 1, "maxLength": 512},
        "asset_requirement_categories": {"$ref": "#/$defs/strings"},
        "effects_intensity_category": {"type": "string", "minLength": 1, "maxLength": 512},
        "audio_considerations": {"$ref": "#/$defs/strings"},
        "prototype_suitability": {"type": "string", "minLength": 1, "maxLength": 512},
        "evidence_references": {"$ref": "#/$defs/strings"},
        "qualified_confidence": {"const": "low"}
      }
    },
    "review_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["option_id", "option_content_digest", "profile_identity", "source_ordinal", "considerations", "unresolved_checks", "knowledge_influence", "entry_digest"],
      "properties": {
        "option_id": {"$ref": "#/$defs/id"}, "option_content_digest": {"$ref": "#/$defs/digest"},
        "profile_identity": {"$ref": "#/$defs/id"}, "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 8},
        "considerations": {"$ref": "#/$defs/considerations"}, "unresolved_checks": {"$ref": "#/$defs/nonempty_strings"},
        "knowledge_influence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/knowledge_influence"}]},
        "entry_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
